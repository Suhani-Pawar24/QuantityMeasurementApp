# Ignore everything by default


# Allow src folder
!src/
!src/main/
!src/main/java/
!src/test/
!src/test/java/

# Allow pom.xml
!pom.xml

# Allow .gitignore itself
!.gitignore


# Ignore Maven build output
target/

# Ignore logs
*.log

# Ignore Eclipse files
.project
.classpath
.settings/

# Ignore IntelliJ files
.idea/
*.iml

# Ignore VS Code
.vscode/

# Ignore OS files
.DS_Store
Thumbs.
/.metadata/
.gitignore
